# Local Node server only. For the Worker use `wrangler secret put` / .dev.vars.
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_API_KEY=
PUBLIC_URL=
RETURN_HOSTS=rchtch.app,scalvs.app,cumuluscloud.app,mttrn.app,infinitumcorp.workers.dev
LICENCE_SIGNING_KEY=
CRON_SECRET=
# Optional. Standard reCAPTCHA secret (v2/v3 siteverify, not Enterprise). Unset = signup is not challenged.
RECAPTCHA_SECRET_KEY=
# Optional Always Free AWS. Off unless region + access keys AND SNS_TOPIC_ARN and/or CLOUDWATCH_NAMESPACE are set.
# SNS is HTTP/S Publish only (never SMS or email). CloudWatch is three custom metrics, no dimensions.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SNS_TOPIC_ARN=
CLOUDWATCH_NAMESPACE=
STRIPE_AUTOMATIC_TAX=false
TOKEN_PAYOUTS_ENABLED=false

# @conjure: hosted Conjure prediction service. Key from the Conjure staff dashboard; server-side only.
CONJURE_URL=
CONJURE_PRODUCT_KEY=
